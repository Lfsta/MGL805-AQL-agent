# Copiez ce fichier en .env et ajustez selon votre machine.

# Modèle Ollama à utiliser.
AQL_MODEL=qwen3:8b

# Taille du contexte (en tokens) envoyée à Ollama. Par défaut, Ollama tronque
# silencieusement à une valeur bien plus petite (souvent 4096) — on la fixe
# explicitement ici. Augmenter cette valeur coûte de la VRAM (cache KV).
# 8192 = compromis raisonnable pour un GPU  6-8 Go VRAM.
AQL_NUM_CTX=8192

# Adresse du serveur Ollama. À changer seulement si Ollama ne tourne pas en
# local sur le port par défaut
OLLAMA_HOST=http://localhost:11434